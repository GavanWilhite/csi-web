# pnpm 10.33.0 DOES read behavioural settings from .npmrc, in kebab-case —
# verified empirically, not from docs (pnpm.io currently states .npmrc is
# auth/registry only, which describes the v11 direction and is wrong for 10.x).
# `ignore-scripts` below is itself a behavioural setting and is honoured here.
#
# The release-cooldown and trust policy live in pnpm-workspace.yaml instead, so
# they travel with the repo to CI and to other machines. A global ~/.npmrc
# protects one developer; the committed file protects the build.
ignore-scripts=true
